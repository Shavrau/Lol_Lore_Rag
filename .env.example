# ==============================================================================
# Runeterra Lore RAG - Configurações de Ambiente
# ==============================================================================

# Chave de API do Google Gemini (obtenha em: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Modelos do Gemini para expansão de query e geração de respostas
# Opções: gemini-3.5-flash-lite, gemini-3.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-3.5-flash-lite

# Modelos de Embedding e Reranker (HuggingFace / Sentence-Transformers)
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Diretórios do Projeto (caminhos relativos ou absolutos)
DATA_DIR=./data
BOOKS_DIR=./data/books
WEB_LORE_DIR=./data/web_lore
CACHE_DIR=./data/cache

# Configurações de Chunking e Recuperação
CHUNK_WORDS=320
OVERLAP_WORDS=50
CANDIDATES=50
RERANK_POOL=20
RRF_K=60
NEIGHBORS_FOR_TOP_N=2
DEFAULT_RETRIEVAL_MODE=hybrid+rerank

# Idioma padrão para extração de Lore Web (pt_BR ou en_US)
LORE_LANG=pt_BR
